digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.50", fontname="DejaVu Sans", label="Property Separation: Three Constructive Non-Implications (Not a Complete Lattice)", labelloc=t, fontsize=18];
  node [shape=box, style="rounded,filled", fillcolor="#F7F7F7", color="#444444", fontname="DejaVu Sans", fontsize=10, margin="0.12,0.08"];
  edge [color="#555555", arrowsize=0.7, fontname="DejaVu Sans", fontsize=9];

  W1 [label="W1: ciphertext remains retrievable;\nonly t-1 valid dispute responses arrive by the deadline", fillcolor="#E9F1FF"];
  H1 [label="CA holds", fillcolor="#EAF8EA"];
  F1 [label="AD, DDL, and deadline-bounded DKA fail", fillcolor="#FFE9E9"];
  C1 [label="CA does not imply DKA", shape=note, fillcolor="#FFF4D6"];

  W2 [label="W2: at least q_accept sampled canary responses;\ntarget-selective withholding leaves fewer than t record responses", fillcolor="#E9F1FF"];
  H2 [label="AKR holds", fillcolor="#EAF8EA"];
  F2 [label="Target-record AD and DDL fail", fillcolor="#FFE9E9"];
  C2 [label="A passed routine audit does not unconditionally\nimply targeted dispute success", shape=note, fillcolor="#FFF4D6"];

  W3 [label="W3: two executions share the same finite audit prefix;\nlater readiness diverges", fillcolor="#E9F1FF"];
  H3 [label="Finite audit observations are identical", fillcolor="#EAF8EA"];
  F3 [label="Unconditional future AD/DDL fails\nin one continuation", fillcolor="#FFE9E9"];
  C3 [label="Finite audits do not guarantee\nunconditional future DKA", shape=note, fillcolor="#FFF4D6"];

  B [label="Boundary: DKA is conditional and deadline-bounded.\nPAC and declared readiness/network assumptions remain separate obligations.", shape=doubleoctagon, fillcolor="#DFF5F2", fontsize=11];

  W1 -> H1;
  W1 -> F1;
  H1 -> C1 [style=dashed, label="witness"];
  F1 -> C1 [style=dashed, label="witness"];

  W2 -> H2;
  W2 -> F2;
  H2 -> C2 [style=dashed, label="witness"];
  F2 -> C2 [style=dashed, label="witness"];

  W3 -> H3;
  W3 -> F3;
  H3 -> C3 [style=dashed, label="witness"];
  F3 -> C3 [style=dashed, label="witness"];

  C1 -> B;
  C2 -> B;
  C3 -> B;
}
